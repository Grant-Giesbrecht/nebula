{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nebula Navigator",
  "version": "0.1.0",
  "identifier": "org.nebula.navigator",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nebula Navigator",
        "width": 1040,
        "height": 700,
        "minWidth": 720,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/nebula-bridge"
    ],
    "icon": [
      "icons/nebula.icns"
    ]
  }
}
